[schwab]
client_id = "YOUR_CLIENT_ID"
client_secret = "YOUR_CLIENT_SECRET"
callback_url = "https://127.0.0.1:8182/"
token_file = "~/.local/share/gex_app/schwab_token.json"
max_token_age_days = 7
 
[telegram]
enabled = true                     # set false to mute alerts without removing secrets
BOT_TOKEN = "YOUR_BOT_TOKEN"       # from @BotFather
CHAT_ID = "YOUR_CHAT_ID"           # from @userinfobot (or a negative group id, or @channelname)

# Magic-link login + invite-approval email delivery. Unregistered email
# addresses get an access request sent to operator_addr (default: from_addr).
# Omitted/blank smtp_host disables email: links are then written to the app
# log instead.
[email]
smtp_host = "smtp.gmail.com"
smtp_port = 587              # 465 implies use_ssl
smtp_user = "your-account@gmail.com"
smtp_password = "your-16-character-app-password"  # https://myaccount.google.com/apppasswords
from_addr = "your-account@gmail.com"
use_ssl = false
link_base = "http://localhost:8501"   # app URL the emailed link points to
# operator_addr = ""   # who receives access requests (default: from_addr)
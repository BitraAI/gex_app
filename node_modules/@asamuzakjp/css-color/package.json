{
  "name": "@asamuzakjp/css-color",
  "description": "CSS color - Resolve and convert CSS colors.",
  "author": "asamuzaK",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asamuzaK/cssColor.git"
  },
  "homepage": "https://github.com/asamuzaK/cssColor#readme",
  "bugs": {
    "url": "https://github.com/asamuzaK/cssColor/issues"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "default": "./dist/esm/index.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@csstools/css-calc": "^3.4.3",
    "@csstools/css-color-parser": "^4.2.6",
    "@csstools/css-parser-algorithms": "^4.0.2",
    "@csstools/css-tokenizer": "^4.0.2",
    "lru-cache": "^11.5.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@vitest/coverage-istanbul": "^5.0.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-regexp": "^3.3.1",
    "globals": "^17.13.0",
    "knip": "^6.40.0",
    "mitata": "^1.0.34",
    "neostandard": "^0.14.0-next.1",
    "prettier": "^3.9.9",
    "prettier-plugin-brace-style": "^0.10.3",
    "publint": "^0.3.25",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "scripts": {
    "bench:color": "npx tsx --expose-gc ./benchmark/bench-color.ts",
    "build": "npm run clean && npm run test && npm run knip && vite build && npm run publint",
    "clean": "rimraf ./coverage ./dist",
    "clone": "node ./scripts/clone-txt.js",
    "knip": "knip",
    "lint": "eslint ./src ./test --fix",
    "prettier": "prettier . --ignore-unknown --write",
    "publint": "publint --strict",
    "test": "npm run prettier && npm run lint && npm run test:types && npm run test:unit",
    "test:types": "tsc",
    "test:unit": "vitest"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "version": "7.1.4"
}
